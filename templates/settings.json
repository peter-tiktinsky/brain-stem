{
  "env": {
    "MEMORY_GLOBALIZE_MODE": "propose"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/pre-write-guard.sh"
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/pre-asq-guard.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/track-vault-write.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/post-write-verify.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/memory-auto-stamp.sh",
            "timeout": 3
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/memory-globalize-auto.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/tasks-md-autosync.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/post-tool-use-manifest.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/post-manifest-binder-refresh.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/post-work-map-refresh.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/post-handoff-refresh.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/prompt-context.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/spec-context-inject.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/pre-research-check.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/session-register.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/cron-health-banner.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/session-start-launchd-bootstrap.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/memory-review-banner.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/spec-context-inject.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/session-start.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/memory-seed.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/session-start-integrity-backstop.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/session-start-project-context.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/session-start-home-launch-warn.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/session-start-placement-findings.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/stop-checkpoint-check.sh",
            "timeout": 3
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "auto|manual",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/pre-compact-checkpoint.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/session-deregister.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/session-episode-write.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/memory-consolidation-check.sh"
          }
        ]
      }
    ],
    "InstructionsLoaded": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/instructions-loaded-log.sh",
            "timeout": 3
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/hooks/worker-statusline.sh"
  }
}
