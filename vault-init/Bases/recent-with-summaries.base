# Starter Obsidian Base (Bases core plugin, Obsidian 1.9.10+).
# Recently-updated notes as cards, surfacing the cohort `description` as the card
# subtitle — the human-readable summary line that also feeds RAG/MCP relevance
# pre-filtering. Bases reads frontmatter only.
filters:
  and:
    - 'description != null'
views:
  - type: cards
    name: Recent (with summaries)
    order:
      - file.name
      - description
      - type
      - updated
    sort:
      - property: updated
        direction: DESC
    limit: 50
